# 复制为 .env 并按实际情况修改
DB_USER=root
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zhuanzong2

# JWT 密钥，生产环境务必改成随机长字符串
SECRET_KEY=please-change-this-secret-key

# MiniMax 大模型配置（Key 仅保存在后端 .env 中）
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_TIMEOUT_SECONDS=600
MINIMAX_MAX_TOKENS=32000
